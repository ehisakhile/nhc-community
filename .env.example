APP_NAME="NHC Community"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nhc_central
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Staff sign-in codes go out by email: any SMTP server works.
# Use "log" locally to read codes in storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="records@your-clinic.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS (Termii). Only used to confirm a phone at first registration; blank = codes go to the log.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://v4.api.termii.com
TERMII_CHANNEL=generic

# Optional: Hospify Connect, which lets your patients use the Hospify Citizen app.
# Leave blank to run on your own. Hospify gives you these values if you connect.
HOSPIFY_PUBLIC_KEY=
NHC_PATIENT_TOKEN_MINUTES=60
HOSPIFY_API_URL=
NHC_EVENTS_SECRET=

# Facility registrations and enquiries are emailed here (and always saved).
NHC_ENQUIRIES_TO=

# Optional error monitoring with LoggerAI. Empty key = off.
LOGGERAI_KEY=
LOGGERAI_SERVICE=nhc-community
LOGGERAI_SESSIONS=false
